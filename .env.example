# Copy to .env and fill in. Never commit .env.

# --- required ---------------------------------------------------------------
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Use URL-safe characters only (it is embedded in a connection URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- web address ---------------------------------------------------------------
# Host name(s) users type in the browser, comma separated (no scheme).
DJANGO_ALLOWED_HOSTS=agriaura.example.org
# Full origin(s) incl. scheme, needed for the /admin login over https.
DJANGO_CSRF_TRUSTED_ORIGINS=https://agriaura.example.org
# True when users reach the site over https (TLS terminated in front of this stack).
DJANGO_HTTPS=True
HTTP_PORT=80

# --- optional -------------------------------------------------------------------
POSTGRES_DB=agriaura
POSTGRES_USER=agriaura
TZ=Asia/Kolkata
WEATHER_SYNC_INTERVAL_MINUTES=60
WEATHER_SYNC_MAX_RETRIES=3
# Open-Meteo is the only weather provider. The free servers need no key.
# Purchased commercial key: leave EMPTY here. The real key goes only in your private .env file.
OPEN_METEO_API_KEY=
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# OPEN_METEO_TIMEOUT_SECONDS=15
# Where Postgres keeps its files / where backups go. Defaults: a Docker volume / ./backups.
# Set these to paths on the data-centre storage service once it is mounted, e.g. /mnt/storage/agriaura/pgdata
# PGDATA_PATH=
# BACKUP_PATH=
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
